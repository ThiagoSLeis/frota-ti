# URL base da API.
# Em desenvolvimento pode ficar vazio: o Vite faz proxy de /api para o backend
# (veja `server.proxy` em vite.config.js).
VITE_API_URL=

# Porta do dev server (opcional, padrao 5173)
# VITE_PORT=5173

# Alvo do proxy em desenvolvimento (opcional, padrao http://localhost:3333)
# VITE_PROXY_TARGET=http://localhost:3333
