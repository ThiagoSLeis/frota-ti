# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3333
NODE_ENV=development

# Origens liberadas no CORS (separadas por virgula). "*" libera todas.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Google Sheets (use SUAS credenciais - nunca comite as reais)
# Passo a passo completo em docs/02-google-sheets-setup.md
# ---------------------------------------------------------------------------

# ID da planilha: https://docs.google.com/spreadsheets/d/<ESTE_PEDACO>/edit
GOOGLE_SHEET_ID=1FaKe_sHeEt_Id_CoLe_O_sEu_AqUi_000000000000

# E-mail da service account (campo client_email do JSON de credenciais)
GOOGLE_SERVICE_ACCOUNT_EMAIL=frota-ti-bot@seu-projeto.iam.gserviceaccount.com

# Chave privada (campo private_key do JSON). Mantenha entre aspas e com os \n literais.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHAVE_FALSA_SUBSTITUA_PELA_SUA\n-----END PRIVATE KEY-----\n"

# Nome da aba que funciona como tabela (padrao: Inventário)
SHEET_TAB_NAME=Inventário

# Popular a planilha com 5 equipamentos de exemplo ao rodar `npm run sheets:init`
SEED_SAMPLE_DATA=true
